<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <RootNamespace></RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.113.1" ExcludeAssets="native" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Data" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tools/DetailTaxMigration/Migration.vb" Link="Migration.vb" />
    <Compile Include="../../tools/DetailTaxMigration/ExactMoney.vb" Link="ExactMoney.vb" />
    <Compile Include="../../tools/DetailTaxMigration/MigrationFiles.vb" Link="MigrationFiles.vb" />
    <None Include="../../docs/schema/monetail_schema.sql" Link="schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/migrations/20261017_01_shop_tax_rounding.sql" Link="rounding.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/migrations/20261019_01_revision_tokens.sql" Link="revision.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
