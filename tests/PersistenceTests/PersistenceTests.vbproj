<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace></RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- Use the package build targets for x86/x64 interop; exclude flattened native runtime assets. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.113.1" ExcludeAssets="native" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml.Linq" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Drawing" />
    <ProjectReference Include="../OriginalControls.TestBuild/OriginalControls.TestBuild.vbproj" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Data/**/*.vb" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/DataAccess/*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Logic/ExactMoney.vb" Link="Production/ExactMoney.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Logic/Calculation.vb" Link="Production/Calculation.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Logic/IntegerExpression.vb" Link="Production/IntegerExpression.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Logic/ReceiptAmountValidation.vb" Link="Production/ReceiptAmountValidation.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/RegisterForm*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/RegisterTransferForm*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/RegisterBalanceForm*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm.Designer.vb" Link="Production/ViewForm.Designer.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/BalanceDisplay.vb" Link="Production/BalanceDisplay.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm_BalanceStatistics.vb" Link="Production/ViewForm_BalanceStatistics.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm_List.vb" Link="Production/ViewForm_List.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm_Statistics.vb" Link="Production/ViewForm_Statistics.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm_ListStatistics.vb" Link="Production/ViewForm_ListStatistics.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/ViewForm_Expenses.vb" Link="Production/ViewForm_Expenses.vb" />
    <Compile Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/Control/DetailViewForm*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../tools/DetailTaxMigration/Migration.vb" Link="Production/DetailTaxMigration.vb" />
    <Compile Include="../Shared/Assertions.vb" Link="Assertions.vb" />
    <Compile Include="../Shared/IntegerExpressionCases.vb" Link="IntegerExpressionCases.vb" />
    <Compile Include="../Shared/ReceiptFixtures.vb" Link="ReceiptFixtures.vb" />
    <None Include="../../docs/schema/monetail_schema.sql" Link="monetail_schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/migrations/20261017_01_shop_tax_rounding.sql" Link="tax_rounding.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/migrations/20261019_01_revision_tokens.sql" Link="revision_tokens.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/App.config" Link="startup-source.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/My Project/Settings.settings" Link="startup-source.settings" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../HouseholdAccountsBeta/HouseholdAccountsBeta/My Project/Settings.Designer.vb" Link="startup-settings-source.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
