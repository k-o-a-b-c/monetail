<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Monetail.WinUI" xmlns:views="using:Monetail.WinUI.Views" xmlns:receipts="using:Monetail.WinUI.Views.Receipts" xmlns:transfers="using:Monetail.WinUI.Views.Transfers" xmlns:input="using:Monetail.WinUI.Input" x:Class="Monetail.WinUI.MainWindow">
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <InfoBar x:Name="ErrorNotice" IsOpen="False" Visibility="Collapsed" Closed="CloseError" Severity="Error" IsClosable="True" Margin="24,16,24,0" AutomationProperties.LiveSetting="Polite"/>
        <ContentControl x:Name="Operations" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="WorkspaceHeader" Visibility="Collapsed" Margin="32,32,32,24" RowSpacing="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/></Grid.RowDefinitions>
<Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LedgerSelector" Click="ShowLedgerMenu" IsEnabled="False" Style="{StaticResource HeaderButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" MaxWidth="320" MinWidth="0" AutomationProperties.Name="家計簿の切替" AutomationProperties.AutomationId="LedgerSelector">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LedgerName" Text="家計簿を選択" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <FontIcon Grid.Column="1" Glyph="" FontSize="12"/>
                    </Grid>
                </Button>
                <Grid Grid.Column="1">
                    <Button x:Name="RecordButton" Content="記録" Style="{StaticResource HeaderButton}" FontWeight="SemiBold" AutomationProperties.ItemStatus="選択中" Click="ShowRecord" AutomationProperties.AutomationId="RecordButton"/>
                    <Border x:Name="RecordSelectionIndicator" Height="3" Width="32" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                </Grid>
                <Button Grid.Column="2" Content="集計・分析" IsEnabled="False" AutomationProperties.AutomationId="AnalyticsPlaceholder" Style="{StaticResource HeaderButton}" HorizontalAlignment="Left"/>
                <Button x:Name="SettingsButton" Grid.Column="3" Click="ShowManagement" Style="{StaticResource HeaderButton}" Padding="12,12" AutomationProperties.AutomationId="SettingsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="" FontSize="16"/>
                        <TextBlock Text="管理・設定" FontSize="16"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                </Grid>
                <Frame x:Name="WorkspaceHost" Grid.Row="1" IsNavigationStackEnabled="False" Visibility="Collapsed"/>
            </Grid>
        </ContentControl>
<Grid x:Name="EditorContents">
<Grid x:Name="TransferEditorPage" TabFocusNavigation="Local" Visibility="Collapsed">
                <transfers:TransferEditorView x:Name="TransferEntry"/>
            </Grid>
<Grid x:Name="ReceiptEditorPage" Visibility="Collapsed">
                <receipts:ReceiptEditorView x:Name="ReceiptEntry"/>
            </Grid>
        </Grid>
        <ContentDialog x:Name="ReceiptConfirmationDialog" DefaultButton="Close"/>
        <ContentControl x:Name="AuthenticationHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
        <ContentControl x:Name="LedgerPageHost" Grid.Row="1" IsTabStop="False" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ProgressRing x:Name="BusyProgress" Grid.RowSpan="2" Visibility="Collapsed" IsActive="False" Width="24" Height="24" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.Name="処理中"/>
        <ContentDialog x:Name="TransferConfirmationDialog" Title="確認" PrimaryButtonText="続行" CloseButtonText="キャンセル" DefaultButton="Close"/>
    </Grid>
</Window>