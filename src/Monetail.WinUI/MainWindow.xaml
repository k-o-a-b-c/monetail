<Window
    x:Class="Monetail.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monetail.WinUI"
    xmlns:input="using:Monetail.WinUI.Input">
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="Description" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ErrorNotice" IsOpen="False" Visibility="Collapsed" Closed="CloseError" Severity="Error" IsClosable="True" Margin="24,16,24,0"
                 AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="1">
        <ContentControl x:Name="Operations" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
        <Grid x:Name="ConnectionPage" Visibility="Collapsed" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                    <TextBlock Text="接続先の設定" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="サーバーのURLを入力してください。" Style="{StaticResource Description}" />
                    <TextBox x:Name="ServerUrl" Header="サーバーURL" PlaceholderText="https://…" InputScope="Url" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ConnectButton" Content="接続" Click="Connect" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="ConnectionCancel" Content="キャンセル" Click="CancelConnection" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="LoginPage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" />
                <Button x:Name="LoginButton" Content="ログイン" Click="Login" Style="{ThemeResource AccentButtonStyle}" />
                <HyperlinkButton Content="接続先の変更" Click="ShowConnection" />
            </StackPanel>
        </Grid>
        <Grid x:Name="FailurePage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="FailureMessage" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="RetryButton" Content="再試行" Click="RetryConnection" Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="接続先の変更" Click="ShowConnection" />
                    <Button Content="終了" Click="Exit" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="LedgerChoicePage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="家計簿を選択" Style="{ThemeResource TitleTextBlockStyle}" />
                <ListView x:Name="LedgerChoices" DisplayMemberPath="Name" SelectionMode="Single" MaxHeight="320"
                          SelectionChanged="ChooseLedger" AutomationProperties.Name="参加している家計簿" />
                <Button x:Name="OpenLedgerButton" Content="開く" IsEnabled="False" Click="OpenSelectedLedger"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="LedgerCreatePage" Visibility="Collapsed" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                    <TextBlock Text="家計簿の作成" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="NoLedgersNotice" Text="参加している家計簿はありません。&#x0a;参加する場合は、管理者から招待リンクを受け取ってください。"
                               Style="{StaticResource Description}" />
                    <TextBox x:Name="NewLedgerName" Header="家計簿名" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CreateLedgerButton" Content="作成" Click="CreateLedger" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="CancelLedgerCreation" Content="キャンセル" Click="CancelCreation" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="HomePage" Visibility="Collapsed" Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LedgerSelector" Click="ShowLedgerMenu" IsEnabled="False" Style="{StaticResource HeaderButton}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" MaxWidth="320" MinWidth="0"
                        AutomationProperties.Name="家計簿の切替">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LedgerName" Text="家計簿を選択" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
                    </Grid>
                </Button>
                <Grid Grid.Column="1">
                    <Button x:Name="RecordButton" Content="記録" Style="{StaticResource HeaderButton}" FontWeight="SemiBold"
                            AutomationProperties.ItemStatus="選択中" Click="ShowRecord" />
                    <Border Height="3" Width="32" CornerRadius="2" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <Button Grid.Column="2" Content="集計・分析" IsEnabled="False"
                        Style="{StaticResource HeaderButton}" HorizontalAlignment="Left" />
                <Button x:Name="SettingsButton" Grid.Column="3" Click="ShowManagement"
                        Style="{StaticResource HeaderButton}" Padding="12,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="管理・設定" FontSize="16" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Grid x:Name="RecordContent" Grid.Row="2" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Style="{StaticResource Card}">
                    <Grid RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="レシート" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Button x:Name="NewReceiptButton" Grid.Column="1" Content="＋ 登録" Click="NewReceipt"
                                    AutomationProperties.Name="レシートの登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <Grid Grid.Row="2" RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel x:Name="ReceiptFilters" Spacing="8">
                                <StackPanel x:Name="ReceiptOpenNotice" Visibility="Collapsed" Spacing="8">
                                    <ProgressRing x:Name="ReceiptOpenProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ReceiptOpenMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <Button x:Name="ReceiptOpenRetry" Content="再試行" Visibility="Collapsed" Click="RetryReceiptOpen"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ReceiptPrevious" Content="前月" Click="MoveReceiptMonth" VerticalAlignment="Bottom"/>
                                    <TextBox x:Name="ReceiptMonth" Header="年月" PlaceholderText="YYYY-MM" Width="112"
                                             TextChanged="ReceiptDraftChanged" KeyDown="ReceiptTextKeyDown"/>
                                    <Button x:Name="ReceiptNextMonth" Content="翌月" Click="MoveReceiptMonth" VerticalAlignment="Bottom"/>
                                    <CheckBox x:Name="ReceiptAllPeriods" Content="全期間" Checked="ReceiptPeriodChanged" Unchecked="ReceiptPeriodChanged" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="ReceiptMonthError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="ReceiptAppliedMonth" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ReceiptOwner" Header="支払者" DisplayMemberPath="Name" SelectionChanged="ReceiptOwnerChanged" HorizontalAlignment="Stretch"/>
                                    <ComboBox x:Name="ReceiptPayment" Grid.Column="1" Header="支払方法" DisplayMemberPath="Name" SelectionChanged="ReceiptPaymentChanged" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReceiptShop" Header="店名" PlaceholderText="部分一致で検索" TextChanged="ReceiptDraftChanged" KeyDown="ReceiptTextKeyDown"/>
                                    <Button x:Name="ReceiptSearchButton" Grid.Column="1" Content="検索" Click="ApplyReceiptText" VerticalAlignment="Bottom"/>
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <ListView x:Name="ReceiptList" SelectionMode="Single" SelectionChanged="ReceiptSelected" DoubleTapped="ReceiptDoubleTapped" Loaded="ReceiptListLoaded" LayoutUpdated="ReceiptLayoutChanged"
                                          HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          AutomationProperties.Name="レシート一覧">
                                    <ListView.Header>
                                        <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="日時"/><TextBlock Grid.Column="1" Text="店名"/><TextBlock Grid.Column="2" Text="所在地"/>
                                            <TextBlock Grid.Column="3" Text="支払方法"/><TextBlock Grid.Column="4" Text="合計額" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="メモ"/>
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ReceiptRow">
                                            <Grid MinWidth="1000" Padding="12,12" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TransactionAt}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ShopName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ShopName}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ShopLocation}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ShopLocation}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PaymentName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PaymentName}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalAmount}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Memo}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Memo}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.Footer>
                                        <StackPanel HorizontalAlignment="Left" Spacing="8" Margin="12">
                                            <StackPanel x:Name="ReceiptNextNotice" Visibility="Collapsed" Orientation="Horizontal" Spacing="8">
                                                <ProgressRing x:Name="ReceiptNextProgress" IsActive="False" Width="20" Height="20"/><TextBlock Text="読み込み中…" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel x:Name="ReceiptNextFailure" Visibility="Collapsed" Spacing="8">
                                                <TextBlock Text="読み込みに失敗しました" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                                <Button x:Name="ReceiptNextRetry" Content="再試行" Click="RetryReceipt"/>
                                            </StackPanel>
                                            <Button x:Name="ReceiptContinue" Content="続きを読み込む" Visibility="Collapsed" Click="ContinueReceipt"/>
                                        </StackPanel>
                                    </ListView.Footer>
                                </ListView>
                                <StackPanel x:Name="ReceiptInitialNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <ProgressRing x:Name="ReceiptInitialProgress" IsActive="False" Width="32" Height="32"/><TextBlock Text="読み込み中…"/>
                                </StackPanel>
                                <TextBlock x:Name="ReceiptEmpty" Text="該当するレシートがありません" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel x:Name="ReceiptInitialFailure" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <TextBlock x:Name="ReceiptInitialError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <Button x:Name="ReceiptInitialRetry" Content="再試行" Click="RetryReceipt"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="資金移動" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="資金移動の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="資金移動の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="残高登録" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="残高の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="残高登録の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="ReceiptEditorPage" Grid.Row="2" Visibility="Collapsed" RowSpacing="16" SizeChanged="ReceiptEditorSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="ReceiptEditorTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Grid x:Name="ReceiptHeaderRow1" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <input:DateInputBox x:Name="ReceiptDate" Header="取引日" AllowEmpty="False" TextChanged="ReceiptParentTextChanged"/>
                            <input:TimeInputBox x:Name="ReceiptTime" Grid.Column="1" Header="時刻" AllowEmpty="False" TextChanged="ReceiptParentTextChanged"/>
                        </Grid>
                        <Grid x:Name="ReceiptHeaderRow2" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="ReceiptShopName" Header="店名" TextChanged="ReceiptParentTextChanged"/>
                            <TextBox x:Name="ReceiptShopLocation" Grid.Column="1" Header="店舗所在地" TextChanged="ReceiptParentTextChanged"/>
                        </Grid>
                        <Grid x:Name="ReceiptHeaderRow3" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ComboBox x:Name="ReceiptEditorPayment" Header="支払方法" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ReceiptParentChoiceChanged"/>
                            <StackPanel x:Name="ReceiptTaxInclusion" Grid.Column="1" Spacing="4">
                                <TextBlock Text="税込／税抜"/>
                                <RadioButton x:Name="ReceiptTaxIncluded" Content="税込" Tag="0" GroupName="ReceiptInclusion" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected"/>
                                <RadioButton x:Name="ReceiptTaxExcluded" Content="税抜" Tag="1" GroupName="ReceiptInclusion" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected"/>
                            </StackPanel>
                            <StackPanel x:Name="ReceiptTaxRounding" Grid.Column="2" Spacing="4">
                                <TextBlock Text="税端数方式"/>
                                <RadioButton x:Name="ReceiptTaxFloor" Content="切り捨て" Tag="floor" GroupName="ReceiptRounding" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected"/>
                                <RadioButton x:Name="ReceiptTaxHalfUp" Content="四捨五入" Tag="half_up" GroupName="ReceiptRounding" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ReceiptPaymentWarning" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Grid x:Name="ReceiptHeaderRow4" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="繰り返し周期"/>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReceiptInterval" Header="間隔" InputScope="Number" TextChanged="ReceiptParentTextChanged"/>
                                    <ComboBox x:Name="ReceiptUnit" Grid.Column="1" Header="単位" SelectionChanged="ReceiptParentChoiceChanged" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="週" Tag="Week"/><ComboBoxItem Content="月" Tag="Month"/><ComboBoxItem Content="年" Tag="Year"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="間隔が空欄なら繰り返しなし" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ReceiptIntervalError" Visibility="Collapsed" Text="間隔は1以上の整数を入力してください。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <TextBox x:Name="ReceiptMemo" Grid.Column="1" Header="レシートメモ" AcceptsReturn="False" TextWrapping="NoWrap" TextChanged="ReceiptParentTextChanged"/>
                        </Grid>
                        <Grid x:Name="ReceiptCategoryArea" ColumnSpacing="24" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="ReceiptCategoryPane" Spacing="12">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ReceiptCategoryChoice" Header="追加する科目" IsTextSearchEnabled="True" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ReceiptCategoryChoiceChanged"/>
                                    <Button x:Name="ReceiptCategoryAdd" Grid.Column="1" Content="追加" Click="AddReceiptCategory" IsEnabled="False" VerticalAlignment="Bottom"/>
                                </Grid>
                                <ListView x:Name="ReceiptCategories" SelectionChanged="ReceiptGroupSelectionChanged" SelectionMode="Single" SingleSelectionFollowsFocus="False" IsItemClickEnabled="True" ItemClick="ReceiptCategoryClicked" KeyDown="ReceiptCategoryKeyDown" MaxHeight="260" MinHeight="100" AutomationProperties.Name="追加済み科目">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="local:ReceiptCategoryRow">
                                        <Grid Padding="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ReferenceAmount, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <TextBox x:Name="ReceiptCategoryMemo" Header="科目メモ" AcceptsReturn="False" TextWrapping="NoWrap" TextChanged="ReceiptGroupMemoChanged" IsEnabled="False"/>
                                <Button x:Name="ReceiptCategoryRemove" Content="科目を削除" Click="RemoveReceiptCategory" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel x:Name="ReceiptDetailsArea" Grid.Column="1" Spacing="8" MinHeight="220" PreviewKeyDown="ReceiptDetailKeyDown">
                                <TextBlock Text="明細" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <Grid x:Name="ReceiptDetailForm" ColumnSpacing="16" RowSpacing="8" SizeChanged="ReceiptDetailFormSizeChanged">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBox x:Name="ReceiptItemName" Header="品名" TextChanged="ReceiptDetailTextChanged"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="ReceiptItemPrice" Header="単価" TextChanged="ReceiptDetailTextChanged"/>
                                            <TextBox x:Name="ReceiptItemQuantity" Grid.Column="1" Header="数量" TextChanged="ReceiptDetailTextChanged"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="ReceiptItemDiscount" Header="単価値引（円）" TextChanged="ReceiptDetailTextChanged"/>
                                            <TextBox x:Name="ReceiptItemRateDiscount" Grid.Column="1" Header="率値引（%）" TextChanged="ReceiptDetailTextChanged"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ReceiptItemTax" Header="税率" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged"/>
                                            <ComboBox x:Name="ReceiptItemExpense" Grid.Column="1" Header="費用区分" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged">
                                                <ComboBoxItem Content="固定費" Tag="Fixed"/><ComboBoxItem Content="変動費" Tag="Variable"/><ComboBoxItem Content="対象外" Tag="Excluded"/>
                                            </ComboBox>
                                        </Grid>
                                        <ComboBox x:Name="ReceiptItemOccurrence" Header="発生区分" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged">
                                            <ComboBoxItem Content="定期" Tag="Regular"/><ComboBoxItem Content="不定期" Tag="Irregular"/><ComboBoxItem Content="臨時" Tag="Temporary"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="ReceiptDetailPeoplePane" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="対象人物"/>
                                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                                            <StackPanel x:Name="ReceiptDetailPeople" PreviewKeyDown="ReceiptPeopleKeyDown"/>
                                        </ScrollViewer>
