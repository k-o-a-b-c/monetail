                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{x:Bind IncomeExpense}"/><TextBlock Grid.Column="2" Text="{x:Bind TaxCategory}"/><TextBlock Grid.Column="3" Text="{x:Bind ValidFrom}"/><TextBlock Grid.Column="4" Text="{x:Bind ValidTo}"/>
