<Window
    x:Class="Monetail.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monetail.WinUI"
    xmlns:input="using:Monetail.WinUI.Input">
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="Description" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ErrorNotice" IsOpen="False" Visibility="Collapsed" Closed="CloseError" Severity="Error" IsClosable="True" Margin="24,16,24,0"
                 AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="1">
        <ContentControl x:Name="Operations" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
        <Grid x:Name="ConnectionPage" Visibility="Collapsed" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                    <TextBlock Text="接続先の設定" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="サーバーのURLを入力してください。" Style="{StaticResource Description}" />
                    <TextBox x:Name="ServerUrl" Header="サーバーURL" PlaceholderText="https://…" InputScope="Url" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ConnectButton" Content="接続" Click="Connect" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="ConnectionCancel" Content="キャンセル" Click="CancelConnection" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="LoginPage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" />
                <Button x:Name="LoginButton" Content="ログイン" Click="Login" Style="{ThemeResource AccentButtonStyle}" />
                <HyperlinkButton Content="接続先の変更" Click="ShowConnection" />
            </StackPanel>
        </Grid>
        <Grid x:Name="FailurePage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="FailureMessage" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="RetryButton" Content="再試行" Click="RetryConnection" Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="接続先の変更" Click="ShowConnection" />
                    <Button Content="終了" Click="Exit" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="LedgerChoicePage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="家計簿を選択" Style="{ThemeResource TitleTextBlockStyle}" />
                <ListView x:Name="LedgerChoices" DisplayMemberPath="Name" SelectionMode="Single" MaxHeight="320"
                          SelectionChanged="ChooseLedger" AutomationProperties.Name="参加している家計簿" />
                <Button x:Name="OpenLedgerButton" Content="開く" IsEnabled="False" Click="OpenSelectedLedger"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="LedgerCreatePage" Visibility="Collapsed" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                    <TextBlock Text="家計簿の作成" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="NoLedgersNotice" Text="参加している家計簿はありません。&#x0a;参加する場合は、管理者から招待リンクを受け取ってください。"
                               Style="{StaticResource Description}" />
                    <TextBox x:Name="NewLedgerName" Header="家計簿名" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CreateLedgerButton" Content="作成" Click="CreateLedger" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="CancelLedgerCreation" Content="キャンセル" Click="CancelCreation" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="HomePage" Visibility="Collapsed" Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LedgerSelector" Click="ShowLedgerMenu" IsEnabled="False" Style="{StaticResource HeaderButton}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" MaxWidth="320" MinWidth="0"
                        AutomationProperties.Name="家計簿の切替">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LedgerName" Text="家計簿を選択" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
                    </Grid>
                </Button>
                <Grid Grid.Column="1">
                    <Button Content="記録" Style="{StaticResource HeaderButton}" FontWeight="SemiBold"
                            AutomationProperties.ItemStatus="選択中" Click="ShowRecord" />
                    <Border Height="3" Width="32" CornerRadius="2" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <Button Grid.Column="2" Content="集計・分析" IsEnabled="False"
                        Style="{StaticResource HeaderButton}" HorizontalAlignment="Left" />
                <Button x:Name="SettingsButton" Grid.Column="3" Click="ShowManagement"
                        Style="{StaticResource HeaderButton}" Padding="12,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="管理・設定" FontSize="16" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Grid Grid.Row="2" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Style="{StaticResource Card}">
                    <Grid RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="レシート" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="レシートの登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="レシートの一覧・入力機能は今後追加します。"
                                   Style="{StaticResource Description}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="資金移動" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="資金移動の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="資金移動の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="残高登録" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="残高の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="残高登録の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ManagementPage" Visibility="Collapsed" RowSpacing="16" Padding="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="ReturnButton" Click="ShowRecord" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="記録・集計に戻る" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Row="1" Margin="12,0,0,0" Spacing="8">
                <TextBlock Text="管理・設定" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LedgerContext" Text="家計簿が開かれていません" Style="{StaticResource Description}" />
            </StackPanel>
            <NavigationView x:Name="ManagementNavigation" Grid.Row="2" PaneDisplayMode="Left"
                            IsPaneOpen="True" OpenPaneLength="240" IsPaneToggleButtonVisible="False"
                            IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                            SelectionChanged="SelectManagement">
                <NavigationView.MenuItems>
                    <NavigationViewItemHeader Content="マスタ管理" />
                    <NavigationViewItem x:Name="PeopleNavigation" Content="人物管理" Icon="Contact" />
                    <NavigationViewItem Content="科目管理" IsEnabled="False" />
                    <NavigationViewItem x:Name="PaymentsNavigation" Content="支払方法管理" />
                    <NavigationViewItem Content="店舗管理" IsEnabled="False" />
                    <NavigationViewItemHeader Content="家計簿管理" />
                    <NavigationViewItem x:Name="ParticipantsNavigation" Content="参加者管理" Icon="People" Visibility="Collapsed" />
                    <NavigationViewItemHeader Content="アプリ設定" />
                    <NavigationViewItem x:Name="ConnectionNavigation" Content="接続先の設定" />
                    <NavigationViewItem Content="表示設定" IsEnabled="False" />
                    <NavigationViewItem Content="入力時の初期値" IsEnabled="False" />
                    <NavigationViewItemHeader Content="アカウント" />
                    <NavigationViewItem x:Name="AccountNavigation" Content="ログイン情報" IsEnabled="False" />
                    <NavigationViewItem x:Name="LogoutNavigation" Content="ログアウト" IsEnabled="False" />
                </NavigationView.MenuItems>
                <Border Style="{StaticResource Card}" Margin="16,0,0,0">
                    <Grid>
                    <StackPanel x:Name="ConnectionSettingsContent" Visibility="Collapsed" Spacing="24" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="接続先の設定" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="接続先を変更すると、変更先でのログインが必要です。" Style="{StaticResource Description}" />
                        <TextBox x:Name="SettingsServerUrl" Header="サーバーURL" PlaceholderText="https://…" InputScope="Url" MinWidth="280" />
                        <Button x:Name="SettingsConnectButton" Content="接続" Click="ConnectSettings" Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="AccountContent" Visibility="Collapsed" Spacing="24">
                        <TextBlock Text="ログイン情報" Style="{ThemeResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="表示名" Style="{StaticResource Description}" />
                            <TextBlock x:Name="AccountName" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="接続先" Style="{StaticResource Description}" />
                            <TextBlock x:Name="AccountServer" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="ParticipantsContent" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Spacing="8"><TextBlock Text="参加者管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Text="家計簿の参加者と対応する人物を管理します。" Style="{StaticResource Description}" TextWrapping="Wrap"/></StackPanel>
                        <Button x:Name="OpenInvitationsButton" Grid.Row="1" Content="招待" Click="OpenInvitations"/>
                        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12" Padding="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <TextBlock Text="アカウント"/><TextBlock Grid.Column="1" Text="役割"/><TextBlock Grid.Column="2" Text="対応する人物"/>
                            </Grid>
                            <ListView x:Name="ParticipantsList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="参加者一覧" HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="local:ParticipantRow">
                                    <Grid ColumnSpacing="12" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Role}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Person}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <Button Content="編集" Tag="{x:Bind Member}" Click="EditParticipant" AutomationProperties.Name="参加者を編集"/>
                                            <Button Content="除外" Tag="{x:Bind Member}" Click="ExcludeParticipant" Visibility="{x:Bind ExcludeVisibility}" AutomationProperties.Name="参加者を除外"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <Grid x:Name="InvitationsContent" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button x:Name="BackToParticipantsButton" Content="← 参加者一覧に戻る" Click="BackToParticipants"/>
                        <StackPanel Grid.Row="1" Spacing="8"><TextBlock Text="招待管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Text="招待リンクは7日間有効です。参加時の役割は閲覧者です。リンクの送付先を限定してください。" TextWrapping="Wrap" Style="{StaticResource Description}"/></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="8"><Button x:Name="IssueInvitationButton" Content="新しい招待リンクを発行" Click="IssueInvitation"/>
                            <TextBlock x:Name="InvitationRetryNotice" Visibility="Collapsed" Text="結果を確認できません。同じ要求IDで招待の発行を再試行します。" TextWrapping="Wrap" Style="{StaticResource Description}"/>
                            <TextBlock x:Name="InvitationNotice" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <Grid Grid.Row="3">
                            <ListView x:Name="InvitationsList" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="有効な招待リンク一覧">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="local:LedgerInvitationRow">
                                    <Grid ColumnSpacing="12" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="有効期限" Style="{StaticResource Description}"/><TextBlock Text="{x:Bind Expires}" TextWrapping="Wrap"/></StackPanel>
                                        <Button Grid.Column="1" Content="コピー" Tag="{x:Bind Invitation}" Click="CopyInvitation" AutomationProperties.Name="招待リンクをコピー"/>
                                        <Button Grid.Column="2" Content="取消" Tag="{x:Bind Invitation}" Click="CancelInvitation" AutomationProperties.Name="招待リンクを取り消す"/>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyInvitations" Text="有効な招待リンクはありません。" Visibility="Collapsed" Style="{StaticResource Description}"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PaymentsContent" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="支払方法管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AddPaymentButton" Content="追加" Click="AddPayment"/>
                            <Button x:Name="EditPaymentButton" Content="編集" Click="EditPayment"/>
                            <Button x:Name="DeletePaymentButton" Content="削除" Click="DeletePayment"/>
                        </StackPanel>
                        <CheckBox x:Name="IncludeInactivePayments" Grid.Row="2" Content="有効期間外も表示" Checked="FilterPayments" Unchecked="FilterPayments"/>
                        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12" Padding="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBlock Text="支払方法名"/><TextBlock Grid.Column="1" Text="有効開始日"/><TextBlock Grid.Column="2" Text="有効終了日"/>
                            </Grid>
                            <ListView x:Name="PaymentsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="SelectPayment" HorizontalContentAlignment="Stretch" AutomationProperties.Name="人物別の支払方法一覧">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.GroupStyle><GroupStyle HidesIfEmpty="True"><GroupStyle.HeaderTemplate><DataTemplate x:DataType="local:PaymentGroup">
                                    <Grid ColumnSpacing="12" Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="並び順変更" Tag="{x:Bind OwnerId}" Visibility="{x:Bind OrderVisibility}" Click="OpenPaymentOrder"/>
                                    </Grid>
                                </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="local:PaymentRow">
                                    <Grid ColumnSpacing="12" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{x:Bind ValidFrom}"/><TextBlock Grid.Column="2" Text="{x:Bind ValidTo}"/>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyPayments" Grid.Row="1" Text="表示対象の支払方法はありません。" Visibility="Collapsed" Style="{StaticResource Description}"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PaymentOrderContent" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="支払方法の並び順" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="PaymentOrderOwner" Grid.Row="1" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <InfoBar x:Name="PaymentOrderNotice" Grid.Row="2" Visibility="Collapsed" IsOpen="False" Closed="CloseError"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="MovePaymentUpButton" Content="上へ" Click="MovePaymentUp"/>
                            <Button x:Name="MovePaymentDownButton" Content="下へ" Click="MovePaymentDown"/>
                        </StackPanel>
                        <ListView x:Name="PaymentOrderList" Grid.Row="4" SelectionMode="Single" SelectionChanged="SelectPaymentOrder" AutomationProperties.Name="有効期間外を含む全支払方法の順序">
                            <ListView.ItemTemplate><DataTemplate x:DataType="local:PaymentRow"><TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" Margin="8,12"/></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SavePaymentOrderButton" Content="保存" Click="SavePaymentOrder" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button x:Name="CancelPaymentOrderButton" Content="キャンセル" Click="CancelPaymentOrder"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PersonOrderContent" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="人物の並び順" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="全員で使う並び順を設定します。この画面では本人を先頭に移しません。"
                                   Style="{StaticResource Description}" />
                        <TextBlock x:Name="PersonOrderRestoredNotice" Grid.Row="2" Visibility="Collapsed"
                                   Text="未保存の並び順を復元しました。内容を確認してください。" Style="{StaticResource Description}" />
                        <InfoBar x:Name="PersonOrderNotice" Grid.Row="3" Visibility="Collapsed" IsOpen="False"
                                 IsClosable="True" Closed="CloseError" />
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="MovePersonUpButton" Content="上へ" IsEnabled="False" Click="MovePersonUp" />
                            <Button x:Name="MovePersonDownButton" Content="下へ" IsEnabled="False" Click="MovePersonDown" />
                        </StackPanel>
                        <Grid Grid.Row="5">
                            <ListView x:Name="PersonOrderList" SelectionMode="Single" SelectionChanged="SelectPersonOrder"
                                      AutomationProperties.Name="共通の人物順">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PersonRow">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" Margin="8,12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyPersonOrder" Text="人物は登録されていません。" Visibility="Collapsed"
                                       Style="{StaticResource Description}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SavePersonOrderButton" Content="保存" Click="SavePersonOrder" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="CancelPersonOrderButton" Content="キャンセル" Click="CancelPersonOrder" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PeopleContent" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="人物管理" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="家計簿で使用する人物と有効期間を管理します。"
                                   Style="{StaticResource Description}" />
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddPersonButton" Content="追加" IsEnabled="False" Click="AddPerson" />
                            <Button x:Name="EditPersonButton" Grid.Column="1" Content="編集" IsEnabled="False" Click="EditPerson" />
                            <Button x:Name="DeletePersonButton" Grid.Column="2" Content="削除" IsEnabled="False" HorizontalAlignment="Left" Click="DeletePerson" />
                            <Button x:Name="PersonOrderButton" Grid.Column="3" Content="並び順変更" IsEnabled="False" Click="OpenPersonOrder" />
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="12,8,12,16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="136" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="人物名" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="有効開始日" FontSize="16" />
                                <TextBlock Grid.Column="2" Text="有効終了日" FontSize="16" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4">
                            <ListView x:Name="PeopleList" SelectionMode="Single" SelectionChanged="SelectPerson" AutomationProperties.Name="人物一覧">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PersonRow">
                                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1" Padding="12,16">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="136" />
                                                    <ColumnDefinition Width="136" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="16" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ValidFrom}" FontSize="16" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ValidTo}" FontSize="16" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyPeople" Text="家計簿を開くと、人物が表示されます。"
                                       Style="{StaticResource Description}" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="5" Text="空欄は期間の制限なし" Style="{StaticResource Description}" />
                    </Grid>
                    </Grid>
                </Border>
            </NavigationView>
        </Grid>
        </Grid>
        </ContentControl>
        <Grid x:Name="StartupPage">
            <StackPanel x:Name="StartupNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing x:Name="StartupProgress" IsActive="False" Width="32" Height="32"
                              AutomationProperties.Name="接続中" />
                <TextBlock Text="接続中…" Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="BrowserPage" Visibility="Collapsed" Padding="32">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="ブラウザーでログインしてください。" Style="{StaticResource Description}" />
                <StackPanel x:Name="BrowserActions" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ReopenBrowserButton" Content="ブラウザーを開く" Click="ReopenBrowser" />
                    <Button x:Name="CancelLoginButton" Content="キャンセル" Click="CancelLogin" />
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>
        <ContentDialog x:Name="PersonDialog" Title="人物の追加" PrimaryButtonText="登録" CloseButtonText="キャンセル"
                       DefaultButton="None" Opened="PersonDialogOpened" Closing="PersonDialogClosing"
                       PrimaryButtonClick="SavePerson" HorizontalContentAlignment="Stretch">
            <ScrollViewer x:Name="PersonEditorContent" Visibility="Collapsed"
                          HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch" Spacing="16">
                    <TextBlock x:Name="PersonRestoredNotice" Visibility="Collapsed" Text="未保存の入力を復元しました。内容を確認してください。"
                               Style="{StaticResource Description}" />
                    <TextBlock x:Name="PersonDeleteNotice" Visibility="Collapsed" TextWrapping="Wrap" />
                    <StackPanel x:Name="PersonFields" Spacing="16">
                        <TextBox x:Name="PersonName" Header="人物名" />
                        <TextBlock x:Name="PersonNameError" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                        <input:DateInputBox x:Name="PersonValidFrom" Header="有効開始日" AllowEmpty="True" />
                        <input:DateInputBox x:Name="PersonValidTo" Header="有効終了日" AllowEmpty="True" />
                        <TextBlock x:Name="PersonPeriodError" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="空欄は期間の制限なし" Style="{StaticResource Description}" />
                        <TextBlock x:Name="PersonPeriodPermission" Visibility="Collapsed" Text="有効期間は管理者のみ変更できます。" Style="{StaticResource Description}" />
                    </StackPanel>
                    <Border x:Name="PersonConflict" Visibility="Collapsed" Padding="16" CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ほかの操作で変更されています。" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="最新の保存内容" TextWrapping="Wrap" />
                            <TextBlock Text="人物名" Style="{StaticResource Description}" />
                            <TextBlock x:Name="LatestPersonName" TextWrapping="Wrap" />
                            <TextBlock Text="有効開始日" Style="{StaticResource Description}" />
                            <TextBlock x:Name="LatestPersonFrom" />
                            <TextBlock Text="有効終了日" Style="{StaticResource Description}" />
                            <TextBlock x:Name="LatestPersonTo" />
                            <TextBlock x:Name="PersonConflictExplanation" Text="切り替えると、現在の未保存の入力を最新内容に置き換えます。" TextWrapping="Wrap" />
                            <Button x:Name="UseLatestPersonButton" Content="最新内容に切り替える" Click="UseLatestPerson" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PersonSaveError" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
        <ContentDialog x:Name="PaymentDialog" Title="支払方法の追加" PrimaryButtonText="登録" CloseButtonText="キャンセル" DefaultButton="None"
                       PrimaryButtonClick="SavePayment" Opened="PaymentDialogOpened" Closing="PaymentDialogClosing" HorizontalContentAlignment="Stretch">
            <ScrollViewer x:Name="PaymentEditorContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="PaymentRestoredNotice" Text="未保存の入力を復元しました。内容を確認してください。" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PaymentDeleteNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PaymentFields" Spacing="16">
                        <ComboBox x:Name="PaymentOwnerChoice" Header="所有者" DisplayMemberPath="Name" SelectionChanged="SelectPaymentOwner" HorizontalAlignment="Stretch"/>
                        <StackPanel x:Name="PaymentOwnerFixed"><TextBlock Text="所有者" Style="{StaticResource Description}"/><TextBlock x:Name="PaymentOwnerName" TextWrapping="Wrap"/></StackPanel>
                        <TextBox x:Name="PaymentName" Header="支払方法名"/>
                        <TextBlock x:Name="PaymentNameError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                        <input:DateInputBox x:Name="PaymentFrom" Header="有効開始日" AllowEmpty="True"/>
                        <input:DateInputBox x:Name="PaymentTo" Header="有効終了日" AllowEmpty="True"/>
                        <TextBlock x:Name="PaymentPeriodError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="空欄は期間の制限なし" Style="{StaticResource Description}"/>
                    </StackPanel>
                    <Border x:Name="PaymentConflict" Visibility="Collapsed" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8"><TextBlock Text="ほかの操作で変更されています。最新の保存内容" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Text="所有者" Style="{StaticResource Description}"/><TextBlock x:Name="LatestPaymentOwner" TextWrapping="Wrap"/>
                            <TextBlock Text="支払方法名" Style="{StaticResource Description}"/><TextBlock x:Name="LatestPaymentName" TextWrapping="Wrap"/>
                            <TextBlock Text="有効開始日" Style="{StaticResource Description}"/><TextBlock x:Name="LatestPaymentFrom"/>
                            <TextBlock Text="有効終了日" Style="{StaticResource Description}"/><TextBlock x:Name="LatestPaymentTo"/>
                            <TextBlock Text="切り替えると、未保存の入力や削除対象の確認内容を最新内容に置き換えます。" TextWrapping="Wrap"/>
                            <Button Content="最新内容に切り替える" Click="UseLatestPayment"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PaymentSaveError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
        <ContentDialog x:Name="ParticipantDialog" Title="参加者の編集" PrimaryButtonText="保存" CloseButtonText="キャンセル" DefaultButton="None"
                       PrimaryButtonClick="SaveParticipant" Closing="ParticipantDialogClosing" HorizontalContentAlignment="Stretch">
            <ScrollViewer x:Name="ParticipantEditorContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="ParticipantName" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ParticipantExcludeNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ParticipantFields" Spacing="16">
                        <ComboBox x:Name="ParticipantRole" Header="家計簿内の役割" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="閲覧者" Tag="Viewer"/><ComboBoxItem Content="編集者" Tag="Editor"/><ComboBoxItem Content="管理者" Tag="Admin"/>
                        </ComboBox>
                        <TextBlock x:Name="ParticipantOwnRole" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <ComboBox x:Name="ParticipantPerson" Header="対応する人物" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="ParticipantPersonError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border x:Name="ParticipantConflict" Visibility="Collapsed" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12"><TextBlock Text="ほかの操作で変更されています。最新の保存内容" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LatestParticipant" TextWrapping="Wrap"/>
                            <TextBlock Text="読み込むと、未保存の入力・更新版を最新の内容に置き換えます。" TextWrapping="Wrap"/>
                            <Button x:Name="UseLatestParticipantButton" Content="最新の内容を読み込む" Click="UseLatestParticipant"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ParticipantError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
        <ContentDialog x:Name="InvitationCancelDialog" Title="招待の取消" PrimaryButtonText="取消する" CloseButtonText="キャンセル" DefaultButton="Close"
                       PrimaryButtonClick="ConfirmCancelInvitation" Closing="InvitationDialogClosing" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="InvitationCancelContent" Visibility="Collapsed" Spacing="16"><TextBlock x:Name="InvitationCancelTarget" TextWrapping="Wrap"/>
                <TextBlock x:Name="InvitationCancelError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ContentDialog>
        <ProgressRing x:Name="BusyProgress" Grid.RowSpan="2" Visibility="Collapsed" IsActive="False"
                      Width="24" Height="24" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                      IsHitTestVisible="False" AutomationProperties.Name="処理中" />
    </Grid>
</Window>
