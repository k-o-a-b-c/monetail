<Window
    x:Class="Monetail.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monetail.WinUI">
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="Description" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid x:Name="HomePage" Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LedgerSelector" IsEnabled="False" Style="{StaticResource HeaderButton}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" MaxWidth="320" MinWidth="0"
                        AutomationProperties.Name="家計簿の切替">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LedgerName" Text="家計簿を選択" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
                    </Grid>
                </Button>
                <Grid Grid.Column="1">
                    <Button Content="記録" Style="{StaticResource HeaderButton}" FontWeight="SemiBold"
                            AutomationProperties.ItemStatus="選択中" Click="ShowRecord" />
                    <Border Height="3" Width="32" CornerRadius="2" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <Button Grid.Column="2" Content="集計・分析" IsEnabled="False"
                        Style="{StaticResource HeaderButton}" HorizontalAlignment="Left" />
                <Button x:Name="SettingsButton" Grid.Column="3" Click="ShowManagement"
                        Style="{StaticResource HeaderButton}" Padding="12,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="管理・設定" FontSize="16" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Grid Grid.Row="2" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Style="{StaticResource Card}">
                    <Grid RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="レシート" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="レシートの登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="レシートの一覧・入力機能は今後追加します。"
                                   Style="{StaticResource Description}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="資金移動" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="資金移動の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="資金移動の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="残高登録" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="＋ 登録" IsEnabled="False"
                                    AutomationProperties.Name="残高の登録" />
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="2" Text="残高登録の機能は今後追加します。" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ManagementPage" Visibility="Collapsed" RowSpacing="16" Padding="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="ReturnButton" Click="ShowRecord" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="記録・集計に戻る" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Row="1" Margin="12,0,0,0" Spacing="8">
                <TextBlock Text="管理・設定" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LedgerContext" Text="家計簿が開かれていません" Style="{StaticResource Description}" />
            </StackPanel>
            <NavigationView x:Name="ManagementNavigation" Grid.Row="2" PaneDisplayMode="Left"
                            IsPaneOpen="True" OpenPaneLength="240" IsPaneToggleButtonVisible="False"
                            IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False">
                <NavigationView.MenuItems>
                    <NavigationViewItemHeader Content="マスタ管理" />
                    <NavigationViewItem x:Name="PeopleNavigation" Content="人物管理" Icon="Contact" />
                    <NavigationViewItem Content="科目管理" IsEnabled="False" />
                    <NavigationViewItem Content="口座管理" IsEnabled="False" />
                    <NavigationViewItem Content="店舗管理" IsEnabled="False" />
                    <NavigationViewItemHeader Content="アプリ設定" />
                    <NavigationViewItem Content="表示設定" IsEnabled="False" />
                    <NavigationViewItem Content="入力時の初期値" IsEnabled="False" />
                    <NavigationViewItemHeader Content="アカウント" />
                    <NavigationViewItem Content="ログイン情報" IsEnabled="False" />
                    <NavigationViewItem Content="ログアウト" IsEnabled="False" />
                </NavigationView.MenuItems>
                <Border Style="{StaticResource Card}" Margin="16,0,0,0">
                    <Grid x:Name="PeopleContent" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="人物管理" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="家計簿で使用する人物と有効期間を管理します。"
                                   Style="{StaticResource Description}" />
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="追加" IsEnabled="False" />
                            <Button Grid.Column="1" Content="編集" IsEnabled="False" />
                            <Button Grid.Column="2" Content="削除" IsEnabled="False" HorizontalAlignment="Left" />
                            <Button Grid.Column="3" Content="並び順変更" IsEnabled="False" />
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="12,8,12,16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="136" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="人物名" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="有効開始日" FontSize="16" />
                                <TextBlock Grid.Column="2" Text="有効終了日" FontSize="16" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4">
                            <ListView x:Name="PeopleList" SelectionMode="Single" AutomationProperties.Name="人物一覧">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PersonRow">
                                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1" Padding="12,16">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="136" />
                                                    <ColumnDefinition Width="136" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="16" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ValidFrom}" FontSize="16" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ValidTo}" FontSize="16" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyPeople" Text="家計簿を開くと、人物が表示されます。"
                                       Style="{StaticResource Description}" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="5" Text="空欄は期間の制限なし" Style="{StaticResource Description}" />
                    </Grid>
                </Border>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
