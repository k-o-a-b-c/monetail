<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Monetail.Windows.Presentation.Management" x:Class="Monetail.WinUI.Views.Management.PeoplePage" NavigationCacheMode="Disabled" IsTabStop="False">
    <Border Style="{StaticResource Card}" Margin="16,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorNotice" IsOpen="{x:Bind HasError(ViewModel.ListError), Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Error(ViewModel.ListError), Mode=OneWay, FallbackValue=Collapsed}" Message="{x:Bind ViewModel.ListError, Mode=OneWay}" Severity="Error" IsClosable="True" Closed="CloseNotice"/>
            <Grid x:Name="PeopleContent" RowSpacing="20" Grid.Row="1" Visibility="{x:Bind Hide(ViewModel.IsOrdering), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="人物管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Text="家計簿で使用する人物と有効期間を管理します。" Style="{StaticResource Description}"/>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddPersonButton" Content="追加" AutomationProperties.AutomationId="AddPersonButton" Command="{x:Bind ViewModel.AddCommand, Mode=OneTime}"/>
                    <Button x:Name="EditPersonButton" Grid.Column="1" Content="編集" AutomationProperties.AutomationId="EditPersonButton" Command="{x:Bind ViewModel.EditCommand, Mode=OneTime}"/>
                    <Button x:Name="DeletePersonButton" Grid.Column="2" Content="削除" HorizontalAlignment="Left" AutomationProperties.AutomationId="DeletePersonButton" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}"/>
                    <Button x:Name="PersonOrderButton" Grid.Column="3" Content="並び順変更" AutomationProperties.AutomationId="PersonOrderButton" Command="{x:Bind ViewModel.OrderCommand, Mode=OneTime}"/>
                </Grid>
                <CheckBox x:Name="IncludeInactivePeople" Grid.Row="3" Content="有効期間外も表示" AutomationProperties.AutomationId="IncludeInactivePeople" IsChecked="{x:Bind ViewModel.IncludeInactive, Mode=TwoWay}"/>
                <Border Grid.Row="4" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="136"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="人物名" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="有効開始日" FontSize="16"/>
                        <TextBlock Grid.Column="2" Text="有効終了日" FontSize="16"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="5">
                    <ListView x:Name="PeopleList" SelectionMode="Single" AutomationProperties.Name="人物一覧" AutomationProperties.AutomationId="PeopleList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonRow">
                                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="136"/>
                                            <ColumnDefinition Width="136"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ValidFrom, Mode=OneTime}" FontSize="16"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ValidTo, Mode=OneTime}" FontSize="16"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyPeople" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource Description}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind Show(ViewModel.IsEmpty), Mode=OneWay}"/>
                </Grid>
                <TextBlock Grid.Row="6" Text="空欄は期間の制限なし" Style="{StaticResource Description}"/>
            </Grid>
            <Grid x:Name="PersonOrderContent" Visibility="{x:Bind Show(ViewModel.IsOrdering), Mode=OneWay}" RowSpacing="16" Grid.Row="1" x:Load="{x:Bind ViewModel.IsOrdering, Mode=OneWay}" Loaded="OrderLoaded">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="人物の並び順" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Text="全員で使う並び順を設定します。この画面では本人を先頭に移しません。" Style="{StaticResource Description}"/>
                <TextBlock x:Name="PersonOrderRestoredNotice" Grid.Row="2" Visibility="{x:Bind Show(ViewModel.Restored), Mode=OneWay}" Text="未保存の並び順を復元しました。内容を確認してください。" Style="{StaticResource Description}"/>
                <InfoBar x:Name="PersonOrderNotice" Grid.Row="3" Visibility="{x:Bind Error(ViewModel.OrderNotice), Mode=OneWay, FallbackValue=Collapsed}" IsOpen="{x:Bind HasError(ViewModel.OrderNotice), Mode=OneWay, FallbackValue=False}" IsClosable="True" Closed="CloseError" Message="{x:Bind ViewModel.OrderNotice, Mode=OneWay}" Severity="{x:Bind Severity(ViewModel.OrderNoticeInformational), Mode=OneWay}"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MovePersonUpButton" Content="上へ" AutomationProperties.AutomationId="MovePersonUpButton" Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneTime}"/>
                    <Button x:Name="MovePersonDownButton" Content="下へ" AutomationProperties.AutomationId="MovePersonDownButton" Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneTime}"/>
                </StackPanel>
                <Grid Grid.Row="5">
                    <ListView x:Name="PersonOrderList" SelectionMode="Single" AutomationProperties.Name="共通の人物順" AutomationProperties.AutomationId="PersonOrderList" ItemsSource="{x:Bind ViewModel.OrderRows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonRow">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" Margin="8,12"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyPersonOrder" Text="人物は登録されていません。" Visibility="{x:Bind Empty(ViewModel.OrderRows.Count), Mode=OneWay}" Style="{StaticResource Description}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SavePersonOrderButton" Content="保存" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="SavePersonOrderButton" Command="{x:Bind ViewModel.SaveOrderCommand, Mode=OneTime}"/>
                    <Button x:Name="CancelPersonOrderButton" Content="キャンセル" AutomationProperties.AutomationId="CancelPersonOrderButton" Command="{x:Bind ViewModel.CancelOrderCommand, Mode=OneTime}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
