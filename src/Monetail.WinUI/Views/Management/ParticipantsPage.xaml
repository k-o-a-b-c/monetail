<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Monetail.Windows.Presentation.Management" x:Class="Monetail.WinUI.Views.Management.ParticipantsPage" NavigationCacheMode="Disabled" IsTabStop="False">
    <Border Style="{StaticResource Card}" Margin="16,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorNotice" IsOpen="{x:Bind HasError(ViewModel.ListError), Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Error(ViewModel.ListError), Mode=OneWay, FallbackValue=Collapsed}" Message="{x:Bind ViewModel.ListError, Mode=OneWay}" Severity="Error" IsClosable="True" Closed="CloseNotice"/>
            <Grid x:Name="ParticipantsContent" Visibility="{x:Bind Hide(ViewModel.IsInvitations), Mode=OneWay}" RowSpacing="16" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="参加者管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="家計簿の参加者と対応する人物を管理します。" Style="{StaticResource Description}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="OpenInvitationsButton" Grid.Row="1" Content="招待" AutomationProperties.AutomationId="OpenInvitationsButton" Command="{x:Bind ViewModel.OpenInvitationsCommand, Mode=OneTime}"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="アカウント"/>
                        <TextBlock Grid.Column="1" Text="役割"/>
                        <TextBlock Grid.Column="2" Text="対応する人物"/>
                    </Grid>
                    <ListView x:Name="ParticipantsList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="参加者一覧" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ParticipantsList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParticipantRow">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Role, Mode=OneTime}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Person, Mode=OneTime}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                        <Button Content="編集" Tag="{x:Bind Member, Mode=OneTime}" Click="EditParticipant" AutomationProperties.Name="参加者を編集"/>
                                        <Button Content="除外" Tag="{x:Bind Member, Mode=OneTime}" Click="ExcludeParticipant" Visibility="{x:Bind CanExclude, Mode=OneTime}" AutomationProperties.Name="参加者を除外"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <Grid x:Name="InvitationsContent" Visibility="{x:Bind Show(ViewModel.IsInvitations), Mode=OneWay}" RowSpacing="16" Grid.Row="1" x:Load="{x:Bind ViewModel.IsInvitations, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="BackToParticipantsButton" Content="← 参加者一覧に戻る" AutomationProperties.AutomationId="BackToParticipantsButton" Command="{x:Bind ViewModel.BackCommand, Mode=OneTime}"/>
                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="招待管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="招待リンクは7日間有効です。参加時の役割は閲覧者です。リンクの送付先を限定してください。" TextWrapping="Wrap" Style="{StaticResource Description}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button x:Name="IssueInvitationButton" Content="新しい招待リンクを発行" AutomationProperties.AutomationId="IssueInvitationButton" Command="{x:Bind ViewModel.IssueCommand, Mode=OneTime}"/>
                    <TextBlock x:Name="InvitationRetryNotice" Visibility="{x:Bind Show(ViewModel.HasInvitationDraft), Mode=OneWay}" Text="結果を確認できません。同じ要求IDで招待の発行を再試行します。" TextWrapping="Wrap" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="InvitationNotice" Visibility="{x:Bind Error(ViewModel.InvitationNotice), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.InvitationNotice, Mode=OneWay}"/>
                </StackPanel>
                <Grid Grid.Row="3">
                    <ListView x:Name="InvitationsList" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="有効な招待リンク一覧" AutomationProperties.AutomationId="InvitationsList" ItemsSource="{x:Bind ViewModel.InvitationRows, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LedgerInvitationRow">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="有効期限" Style="{StaticResource Description}"/>
                                        <TextBlock Text="{x:Bind Expires, Mode=OneTime}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="コピー" Tag="{x:Bind Invitation, Mode=OneTime}" Click="CopyInvitation" AutomationProperties.Name="招待リンクをコピー"/>
                                    <Button Grid.Column="2" Content="取消" Tag="{x:Bind Invitation, Mode=OneTime}" Click="CancelInvitation" AutomationProperties.Name="招待リンクを取り消す"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyInvitations" Text="有効な招待リンクはありません。" Visibility="{x:Bind Show(ViewModel.EmptyInvitations), Mode=OneWay}" Style="{StaticResource Description}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
