<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ParticipantDialog" Title="{x:Bind ViewModel.Title, Mode=OneWay}" PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}" CloseButtonText="キャンセル" DefaultButton="{x:Bind Default(ViewModel.IsExcluding), Mode=OneWay}" PrimaryButtonClick="SaveParticipant" Closing="ParticipantDialogClosing" HorizontalContentAlignment="Stretch" x:Class="Monetail.WinUI.Views.Management.ParticipantEditorDialog" IsEnabled="{x:Bind Not(ViewModel.Context.IsBusy), Mode=OneWay}" IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">
    <ScrollViewer x:Name="ParticipantEditorContent" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock x:Name="ParticipantName" TextWrapping="Wrap" FontWeight="SemiBold" Text="{x:Bind ViewModel.Name, Mode=OneWay}"/>
            <TextBlock x:Name="ParticipantExcludeNotice" Visibility="{x:Bind Show(ViewModel.IsExcluding), Mode=OneWay}" TextWrapping="Wrap" Text="{x:Bind ViewModel.ExcludeNotice, Mode=OneWay}"/>
            <StackPanel x:Name="ParticipantFields" Spacing="16" Visibility="{x:Bind Hide(ViewModel.IsExcluding), Mode=OneWay}">
                <ComboBox x:Name="ParticipantRole" Header="家計簿内の役割" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ParticipantRole" Visibility="{x:Bind Hide(ViewModel.IsSelf), Mode=OneWay}" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Role, Mode=TwoWay}">
                    <ComboBoxItem Content="閲覧者" Tag="Viewer"/>
                    <ComboBoxItem Content="編集者" Tag="Editor"/>
                    <ComboBoxItem Content="管理者" Tag="Admin"/>
                </ComboBox>
                <TextBlock x:Name="ParticipantOwnRole" Visibility="{x:Bind Show(ViewModel.IsSelf), Mode=OneWay}" TextWrapping="Wrap" Text="{x:Bind ViewModel.OwnRole, Mode=OneWay}"/>
                <ComboBox x:Name="ParticipantPerson" Header="対応する人物" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ParticipantPerson" SelectionChanged="SelectPerson"/>
                <TextBlock x:Name="ParticipantPersonError" Visibility="{x:Bind Error(ViewModel.PersonError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.PersonError, Mode=OneWay}"/>
            </StackPanel>
            <Border x:Name="ParticipantConflict" Visibility="{x:Bind Show(ViewModel.HasLatest), Mode=OneWay}" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="ほかの操作で変更されています。最新の保存内容" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LatestParticipant" TextWrapping="Wrap" Text="{x:Bind ViewModel.LatestText, Mode=OneWay}"/>
                    <TextBlock Text="読み込むと、未保存の入力・更新版を最新の内容に置き換えます。" TextWrapping="Wrap"/>
                    <Button x:Name="UseLatestParticipantButton" Content="最新の内容を読み込む" Click="UseLatestParticipant" AutomationProperties.AutomationId="UseLatestParticipantButton"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ParticipantError" Visibility="{x:Bind Error(ViewModel.EditorError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.EditorError, Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
