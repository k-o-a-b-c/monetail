<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="InvitationCancelDialog" Title="招待の取消" PrimaryButtonText="取消する" CloseButtonText="キャンセル" DefaultButton="Close" PrimaryButtonClick="ConfirmCancelInvitation" Closing="InvitationDialogClosing" HorizontalContentAlignment="Stretch" x:Class="Monetail.WinUI.Views.Management.InvitationCancellationDialog" IsEnabled="{x:Bind Not(ViewModel.Context.IsBusy), Mode=OneWay}" IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCancelInvitation, Mode=OneWay}">
    <StackPanel x:Name="InvitationCancelContent" Spacing="16">
        <TextBlock x:Name="InvitationCancelTarget" TextWrapping="Wrap" Text="{x:Bind ViewModel.CancelTarget, Mode=OneWay}"/>
        <TextBlock x:Name="InvitationCancelError" Visibility="{x:Bind Error(ViewModel.CancelError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.CancelError, Mode=OneWay}"/>
    </StackPanel>
</ContentDialog>
        
