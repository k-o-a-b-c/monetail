<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:input="using:Monetail.WinUI.Input" x:Name="CategoryDialog" Title="{x:Bind ViewModel.Title, Mode=OneWay}" PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}" CloseButtonText="キャンセル" DefaultButton="{x:Bind Default(ViewModel.IsDeleting), Mode=OneWay}" PrimaryButtonClick="SaveCategory" Opened="CategoryDialogOpened" Closing="CategoryDialogClosing" HorizontalContentAlignment="Stretch" x:Class="Monetail.WinUI.Views.Management.CategoryEditorDialog" IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" IsEnabled="{x:Bind Not(ViewModel.Context.IsBusy), Mode=OneWay}">
    <ScrollViewer x:Name="CategoryEditorContent" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock x:Name="CategoryRestoredNotice" Text="未保存の入力を復元しました。内容を確認してください。" Visibility="{x:Bind Show(ViewModel.Restored), Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CategoryDeleteNotice" Visibility="{x:Bind Show(ViewModel.IsDeleting), Mode=OneWay}" TextWrapping="Wrap" Text="{x:Bind ViewModel.DeleteNotice, Mode=OneWay}"/>
            <StackPanel x:Name="CategoryFields" Spacing="16" Visibility="{x:Bind Hide(ViewModel.IsDeleting), Mode=OneWay}">
                <TextBox x:Name="CategoryName" Header="科目名" AutomationProperties.AutomationId="CategoryName" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="CategoryNameError" Visibility="{x:Bind Error(ViewModel.NameError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.NameError, Mode=OneWay}"/>
                <ComboBox x:Name="CategoryIncome" Header="収支区分" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CategoryIncome" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Income, Mode=TwoWay}">
                    <ComboBoxItem Content="収入" Tag="Income"/>
                    <ComboBoxItem Content="支出" Tag="Expense"/>
                </ComboBox>
                <ComboBox x:Name="CategoryTax" Header="初期税区分" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CategoryTax" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Tax, Mode=TwoWay}">
                    <ComboBoxItem Content="標準" Tag="Standard"/>
                    <ComboBoxItem Content="食品軽減" Tag="ReducedFood"/>
                    <ComboBoxItem Content="新聞軽減" Tag="ReducedNewspaper"/>
                    <ComboBoxItem Content="非課税" Tag="Exempt"/>
                </ComboBox>
                <TextBlock x:Name="CategoryChoiceError" Visibility="{x:Bind Error(ViewModel.ChoiceError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.ChoiceError, Mode=OneWay}"/>
                <input:DateInputBox x:Name="CategoryFrom" Header="有効開始日" AllowEmpty="True" AutomationProperties.AutomationId="CategoryFrom" Text="{x:Bind ViewModel.FromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <input:DateInputBox x:Name="CategoryTo" Header="有効終了日" AllowEmpty="True" AutomationProperties.AutomationId="CategoryTo" Text="{x:Bind ViewModel.ToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="CategoryPeriodError" Visibility="{x:Bind Error(ViewModel.PeriodError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.PeriodError, Mode=OneWay}"/>
                <TextBlock Text="空欄は期間の制限なし" Style="{StaticResource Description}"/>
            </StackPanel>
            <Border x:Name="CategoryConflict" Visibility="{x:Bind Show(ViewModel.HasLatest), Mode=OneWay}" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="ほかの操作で変更されています。最新の保存内容" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Text="科目名" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatestCategoryName" TextWrapping="Wrap" Text="{x:Bind ViewModel.LatestName, Mode=OneWay}"/>
                    <TextBlock Text="収支区分" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatestCategoryIncome" Text="{x:Bind ViewModel.LatestIncome, Mode=OneWay}"/>
                    <TextBlock Text="初期税区分" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatestCategoryTax" Text="{x:Bind ViewModel.LatestTax, Mode=OneWay}"/>
                    <TextBlock Text="有効開始日" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatestCategoryFrom" Text="{x:Bind ViewModel.LatestFrom, Mode=OneWay}"/>
                    <TextBlock Text="有効終了日" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatestCategoryTo" Text="{x:Bind ViewModel.LatestTo, Mode=OneWay}"/>
                    <TextBlock Text="切り替えると、未保存の入力や削除対象の確認内容を最新内容に置き換えます。" TextWrapping="Wrap"/>
                    <Button Content="最新内容に切り替える" Click="UseLatestCategory" AutomationProperties.AutomationId="UseLatestCategoryButton"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CategorySaveError" Visibility="{x:Bind Error(ViewModel.SaveError), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.SaveError, Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
