<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Monetail.Windows.Presentation.Management" x:Class="Monetail.WinUI.Views.Management.CategoriesPage" NavigationCacheMode="Disabled" IsTabStop="False">
    <Border Style="{StaticResource Card}" Margin="16,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorNotice" AutomationProperties.LiveSetting="Polite" IsOpen="{x:Bind HasError(ViewModel.ListError), Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Error(ViewModel.ListError), Mode=OneWay, FallbackValue=Collapsed}" Message="{x:Bind ViewModel.ListError, Mode=OneWay}" Severity="Error" IsClosable="True" Closed="CloseNotice"/>
            <Grid RowSpacing="16" x:Name="CategoriesContent" Grid.Row="1" Visibility="{x:Bind Hide(ViewModel.IsOrdering), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="科目管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddCategoryButton" Content="追加" AutomationProperties.AutomationId="AddCategoryButton" Command="{x:Bind ViewModel.AddCommand, Mode=OneTime}"/>
                    <Button Grid.Column="1" x:Name="EditCategoryButton" Content="編集" AutomationProperties.AutomationId="EditCategoryButton" Command="{x:Bind ViewModel.EditCommand, Mode=OneTime}"/>
                    <Button Grid.Column="2" HorizontalAlignment="Left" x:Name="DeleteCategoryButton" Content="削除" AutomationProperties.AutomationId="DeleteCategoryButton" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}"/>
                    <Button x:Name="CategoryOrderButton" Grid.Column="3" Content="並び順変更" AutomationProperties.AutomationId="CategoryOrderButton" Command="{x:Bind ViewModel.OrderCommand, Mode=OneTime}"/>
                </Grid>
                <CheckBox x:Name="IncludeInactiveCategories" Grid.Row="2" Content="有効期間外も表示" AutomationProperties.AutomationId="IncludeInactiveCategories" IsChecked="{x:Bind ViewModel.IncludeInactive, Mode=TwoWay}"/>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="科目名"/>
                        <TextBlock Grid.Column="1" Text="収支区分"/>
                        <TextBlock Grid.Column="2" Text="初期税区分"/>
                        <TextBlock Grid.Column="3" Text="有効開始日"/>
                        <TextBlock Grid.Column="4" Text="有効終了日"/>
                    </Grid>
                    <ListView x:Name="CategoriesList" Grid.Row="1" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="科目一覧" AutomationProperties.AutomationId="CategoriesList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryRow">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind IncomeExpense, Mode=OneTime}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind TaxCategory, Mode=OneTime}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind ValidFrom, Mode=OneTime}"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind ValidTo, Mode=OneTime}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyCategories" Grid.Row="1" Text="表示対象の科目はありません。" Visibility="{x:Bind Show(ViewModel.IsEmpty), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                </Grid>
            </Grid>
            <Grid x:Name="CategoryOrderContent" Visibility="{x:Bind Show(ViewModel.IsOrdering), Mode=OneWay}" RowSpacing="16" Grid.Row="1" x:Load="{x:Bind ViewModel.IsOrdering, Mode=OneWay}" Loaded="OrderLoaded">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="科目の並び順" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Text="有効期間外を含むすべての科目を並べ替えます。" Style="{StaticResource Description}" TextWrapping="Wrap"/>
                <InfoBar x:Name="CategoryOrderNotice" Grid.Row="2" Visibility="{x:Bind Error(ViewModel.OrderNotice), Mode=OneWay, FallbackValue=Collapsed}" IsOpen="{x:Bind HasError(ViewModel.OrderNotice), Mode=OneWay, FallbackValue=False}" Closed="CloseError" Message="{x:Bind ViewModel.OrderNotice, Mode=OneWay}" Severity="{x:Bind Severity(ViewModel.OrderNoticeInformational), Mode=OneWay}"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MoveCategoryUpButton" Content="上へ" AutomationProperties.AutomationId="MoveCategoryUpButton" Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneTime}"/>
                    <Button x:Name="MoveCategoryDownButton" Content="下へ" AutomationProperties.AutomationId="MoveCategoryDownButton" Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneTime}"/>
                </StackPanel>
                <ListView x:Name="CategoryOrderList" Grid.Row="4" SelectionMode="Single" AutomationProperties.Name="有効期間外を含む全科目の順序" AutomationProperties.AutomationId="CategoryOrderList" ItemsSource="{x:Bind ViewModel.OrderRows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryRow">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" Margin="8,12"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveCategoryOrderButton" Content="保存" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveCategoryOrderButton" Command="{x:Bind ViewModel.SaveOrderCommand, Mode=OneTime}"/>
                    <Button x:Name="CancelCategoryOrderButton" Content="キャンセル" AutomationProperties.AutomationId="CancelCategoryOrderButton" Command="{x:Bind ViewModel.CancelOrderCommand, Mode=OneTime}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
