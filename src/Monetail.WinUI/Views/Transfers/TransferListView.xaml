<UserControl
    x:Class="Monetail.WinUI.Views.Transfers.TransferListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:Monetail.Windows.Presentation.Transfers"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="振替" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Bottom" AutomationProperties.HeadingLevel="Level2"/>
            <TextBox x:Name="TransferNameSearch" Grid.Column="1" Header="振替名" PlaceholderText="部分一致で検索" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="TransferTextKeyDown" AutomationProperties.AutomationId="TransferNameSearch"/>
            <Button x:Name="TransferSearchButton" Grid.Column="2" Content="検索" Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}" VerticalAlignment="Bottom" AutomationProperties.Name="振替名で検索" AutomationProperties.AutomationId="TransferSearchButton"/>
            <Button x:Name="TransferReturnToStart" Grid.Column="3" Content="先頭に戻る" Command="{x:Bind ViewModel.ReturnToStartCommand, Mode=OneWay}" Visibility="{x:Bind Show(ViewModel.IsFocused), Mode=OneWay}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="TransferReturnToStart"/>
            <Button x:Name="TransferRegisterPlaceholder" Command="{x:Bind ViewModel.RegisterCommand, Mode=OneWay}" Grid.Column="4" Content="＋ 登録" VerticalAlignment="Bottom" AutomationProperties.Name="振替の登録" AutomationProperties.AutomationId="TransferRegisterPlaceholder"/>
        </Grid>
        <ContentControl Grid.Row="1" Content="{x:Bind OpeningContent, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsTabStop="False"/>
        <Grid Grid.Row="2">
            <ListView x:Name="TransferList" DoubleTapped="TransferDoubleTapped" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="振替一覧" AutomationProperties.AutomationId="TransferList">
                <ListView.Header>
                    <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="日時"/><TextBlock Grid.Column="1" Text="振替名"/><TextBlock Grid.Column="2" Text="振替元"/><TextBlock Grid.Column="3" Text="振替先"/>
                        <TextBlock Grid.Column="4" Text="金額" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="メモ"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="presentation:TransferListItem">
                        <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TransactionAt, Mode=OneWay}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind FromName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FromName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ToName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ToName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Amount, Mode=OneWay}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Memo, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Memo, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel HorizontalAlignment="Left" Spacing="8" Margin="12">
                        <StackPanel x:Name="TransferNextNotice" Visibility="{x:Bind Show(ViewModel.IsContinuationLoading), Mode=OneWay}" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="TransferNextProgress" IsActive="{x:Bind ViewModel.IsContinuationLoading, Mode=OneWay}" Width="20" Height="20"/><TextBlock Text="読み込み中…" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="TransferNextFailure" Visibility="{x:Bind Show(ViewModel.IsContinuationFailure), Mode=OneWay}" Spacing="8">
                            <TextBlock Text="読み込みに失敗しました" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="TransferNextRetry" Content="再試行" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" AutomationProperties.AutomationId="TransferNextRetry"/>
                        </StackPanel>
                        <Button x:Name="TransferContinue" Content="続きを読み込む" Visibility="{x:Bind Show(ViewModel.CanContinue), Mode=OneWay}" Command="{x:Bind ViewModel.ContinueCommand, Mode=OneWay}" AutomationProperties.AutomationId="TransferContinue"/>
                    </StackPanel>
                </ListView.Footer>
            </ListView>
            <StackPanel x:Name="TransferInitialNotice" Visibility="{x:Bind Show(ViewModel.IsInitialLoading), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="TransferInitialProgress" IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" Width="32" Height="32"/><TextBlock Text="読み込み中…"/>
            </StackPanel>
            <TextBlock x:Name="TransferEmpty" Text="該当する振替がありません" Visibility="{x:Bind Show(ViewModel.IsEmpty), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="TransferInitialFailure" Visibility="{x:Bind Show(ViewModel.IsInitialFailure), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock x:Name="TransferInitialError" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="TransferInitialRetry" Content="再試行" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" AutomationProperties.AutomationId="TransferInitialRetry"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
