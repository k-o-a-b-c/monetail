<UserControl
    x:Class="Monetail.WinUI.Views.Transfers.TransferListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:Monetail.Windows.Presentation.Transfers"
    xmlns:views="using:Monetail.WinUI.Views"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <views:RecordListPanel x:Name="Panel" Heading="振替" EmptyText="該当する振替がありません" AutomationPrefix="Transfer"
                           RegisterAutomationId="TransferRegisterPlaceholder" State="{x:Bind ViewModel, Mode=OneWay}"
                           RegisterCommand="{x:Bind ViewModel.RegisterCommand, Mode=OneWay}" ReturnToStartCommand="{x:Bind ViewModel.ReturnToStartCommand, Mode=OneWay}"
                           OpeningContent="{x:Bind OpeningContent, Mode=OneWay}">
        <views:RecordListPanel.ListContent>
            <ListView x:Name="TransferList" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="振替一覧" AutomationProperties.AutomationId="TransferList">
                <ListView.Header>
                    <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="日時"/><TextBlock Grid.Column="1" Text="振替名"/><TextBlock Grid.Column="2" Text="振替元"/><TextBlock Grid.Column="3" Text="振替先"/>
                        <TextBlock Grid.Column="4" Text="金額" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="メモ"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="presentation:TransferListItem">
                        <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TransactionAt, Mode=OneWay}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind FromName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FromName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ToName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ToName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Amount, Mode=OneWay}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Memo, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Memo, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <views:RecordListFooter x:Name="Footer" State="{x:Bind ViewModel, Mode=OneWay}" AutomationPrefix="Transfer"/>
                </ListView.Footer>
            </ListView>
        </views:RecordListPanel.ListContent>
    </views:RecordListPanel>
</UserControl>
