<UserControl
    x:Class="Monetail.WinUI.Views.Receipts.ReceiptListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:Monetail.Windows.Presentation.Receipts"
    xmlns:views="using:Monetail.WinUI.Views"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <views:RecordListPanel x:Name="Panel" Heading="レシート" EmptyText="該当するレシートがありません" AutomationPrefix="Receipt"
                           RegisterAutomationId="NewReceiptButton" State="{x:Bind ViewModel, Mode=OneWay}"
                           RegisterCommand="{x:Bind ViewModel.RegisterCommand, Mode=OneWay}" ReturnToStartCommand="{x:Bind ViewModel.ReturnToStartCommand, Mode=OneWay}"
                           OpeningContent="{x:Bind OpeningContent, Mode=OneWay}">
        <views:RecordListPanel.ListContent>
            <ListView x:Name="ReceiptList" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="レシート一覧" AutomationProperties.AutomationId="ReceiptList">
                    <ListView.Header>
                        <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="日時"/><TextBlock Grid.Column="1" Text="店名"/><TextBlock Grid.Column="2" Text="所在地"/>
                            <TextBlock Grid.Column="3" Text="支払方法"/><TextBlock Grid.Column="4" Text="合計額" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="メモ"/>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="presentation:ReceiptListItem">
                            <Grid MinWidth="1000" Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TransactionAt, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ShopName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ShopName, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ShopLocation, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ShopLocation, Mode=OneWay}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind PaymentName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PaymentName, Mode=OneWay}"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind TotalAmount, Mode=OneWay}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind Memo, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Memo, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                    <views:RecordListFooter x:Name="Footer" State="{x:Bind ViewModel, Mode=OneWay}" AutomationPrefix="Receipt"/>
                </ListView.Footer>
                </ListView>
        </views:RecordListPanel.ListContent>
    </views:RecordListPanel>
</UserControl>
