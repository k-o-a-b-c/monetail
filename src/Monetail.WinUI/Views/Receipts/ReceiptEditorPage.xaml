<Page
    x:Class="Monetail.WinUI.Views.Receipts.ReceiptEditorPage" x:Name="ReceiptEditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Monetail.WinUI.Input"
    xmlns:presentation="using:Monetail.Windows.Presentation.Receipts"
    IsTabStop="False">
<Grid Margin="32,0,32,32" RowSpacing="16" SizeChanged="ParentSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button x:Name="ReceiptBack" Content="← 戻る" Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}" AutomationProperties.AutomationId="ReceiptBack"/>
    <ScrollViewer Grid.Row="1" x:Name="ReceiptInputScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <InfoBar x:Name="ReceiptRecoveryNotice" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.RecoveryMessage, Mode=OneWay}" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="ReceiptMasterRetry" Content="再試行" Command="{x:Bind ViewModel.RetryMastersCommand, Mode=OneWay}" Visibility="{x:Bind Show(ViewModel.ShowRetryMasters), Mode=OneWay, FallbackValue=Collapsed}"/>
            <TextBlock x:Name="ReceiptEditorTitle" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <Grid x:Name="ReceiptHeaderRow1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <input:DateInputBox x:Name="ReceiptDate" Header="取引日" AllowEmpty="False" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptDate"/>
                <input:TimeInputBox x:Name="ReceiptTime" Grid.Column="1" Header="時刻" AllowEmpty="False" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptTime"/>
            </Grid>
            <Grid x:Name="ReceiptHeaderRow2" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="ReceiptShopName" Header="店名" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptShopName"/>
                <TextBox x:Name="ReceiptShopLocation" Grid.Column="1" Header="店舗所在地" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptShopLocation"/>
            </Grid>
            <Grid x:Name="ReceiptHeaderRow3" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox x:Name="ReceiptEditorPayment" Header="支払方法"  HorizontalAlignment="Stretch" SelectionChanged="ReceiptParentChoiceChanged" AutomationProperties.AutomationId="ReceiptEditorPayment">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="presentation:ReceiptPaymentChoice"><TextBlock Text="{x:Bind Name, Mode=OneTime}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel x:Name="ReceiptTaxInclusion" Grid.Column="1" Spacing="4">
                    <TextBlock Text="税込／税抜"/>
                    <RadioButton x:Name="ReceiptTaxIncluded" Content="税込" Tag="0" GroupName="ReceiptInclusion" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected" AutomationProperties.AutomationId="ReceiptTaxIncluded"/>
                    <RadioButton x:Name="ReceiptTaxExcluded" Content="税抜" Tag="1" GroupName="ReceiptInclusion" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected" AutomationProperties.AutomationId="ReceiptTaxExcluded"/>
                </StackPanel>
                <StackPanel x:Name="ReceiptTaxRounding" Grid.Column="2" Spacing="4">
                    <TextBlock Text="税端数方式"/>
                    <RadioButton x:Name="ReceiptTaxFloor" Content="切り捨て" Tag="floor" GroupName="ReceiptRounding" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected" AutomationProperties.AutomationId="ReceiptTaxFloor"/>
                    <RadioButton x:Name="ReceiptTaxHalfUp" Content="四捨五入" Tag="half_up" GroupName="ReceiptRounding" Checked="ReceiptTaxChecked" Click="ReceiptTaxSelected" AutomationProperties.AutomationId="ReceiptTaxHalfUp"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ReceiptPaymentWarning" Text="選択中の支払方法は取引日に利用できません。入力値は保持しています。" Visibility="{x:Bind Show(ViewModel.PaymentInvalid), Mode=OneWay, FallbackValue=Collapsed}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <Grid x:Name="ReceiptHeaderRow4" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="繰り返し周期"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ReceiptInterval" Header="間隔" InputScope="Number" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptInterval"/>
                        <ComboBox x:Name="ReceiptUnit" Grid.Column="1" Header="単位" SelectionChanged="ReceiptParentChoiceChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ReceiptUnit">
                            <ComboBoxItem Content="週" Tag="Week"/><ComboBoxItem Content="月" Tag="Month"/><ComboBoxItem Content="年" Tag="Year"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="間隔が空欄なら繰り返しなし" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ReceiptIntervalError" Visibility="{x:Bind Show(ViewModel.IntervalInvalid), Mode=OneWay, FallbackValue=Collapsed}" Text="間隔は1以上の整数を入力してください。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel x:Name="ReceiptMemoArea" Grid.Column="1" Spacing="4">
                    <TextBox x:Name="ReceiptMemo" Header="レシートメモ" AcceptsReturn="False" TextWrapping="NoWrap" TextChanged="ReceiptParentTextChanged" AutomationProperties.AutomationId="ReceiptMemo"/>
                    <TextBlock x:Name="ReceiptMemoError" Visibility="{x:Bind Show(ViewModel.MemoInvalid), Mode=OneWay, FallbackValue=Collapsed}" Text="レシートメモは100文字以内で入力してください。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ReceiptCategoryArea" ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="ReceiptCategoryPane" Spacing="12">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ReceiptCategoryChoice" Header="追加する科目" IsTextSearchEnabled="True" HorizontalAlignment="Stretch" SelectionChanged="ReceiptCategoryChoiceChanged" AutomationProperties.AutomationId="ReceiptCategoryChoice">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="presentation:ReceiptPaymentChoice"><TextBlock Text="{x:Bind Name, Mode=OneTime}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                        <Button x:Name="ReceiptCategoryAdd" Grid.Column="1" Content="追加" Click="AddReceiptCategory" IsEnabled="False" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ReceiptCategoryAdd"/>
                    </Grid>
                    <ListView x:Name="ReceiptCategories" SelectionChanged="ReceiptGroupSelectionChanged" SelectionMode="Single" SingleSelectionFollowsFocus="False" IsItemClickEnabled="True" ItemClick="ReceiptCategoryClicked" KeyDown="ReceiptCategoryKeyDown" MaxHeight="260" MinHeight="100" AutomationProperties.Name="追加済み科目" AutomationProperties.AutomationId="ReceiptCategories">
                        <ListView.ItemTemplate><DataTemplate x:DataType="presentation:ReceiptCategoryRow">
                            <Grid Padding="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ReferenceAmount, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBox x:Name="ReceiptCategoryMemo" Header="科目メモ" AcceptsReturn="False" TextWrapping="NoWrap" TextChanged="ReceiptGroupMemoChanged" IsEnabled="False" AutomationProperties.AutomationId="ReceiptCategoryMemo"/>
                    <Button x:Name="ReceiptCategoryRemove" IsEnabled="{x:Bind ViewModel.CanRemoveCategory, Mode=OneWay, FallbackValue=False}" Content="科目を削除" Click="RemoveReceiptCategory" AutomationProperties.AutomationId="ReceiptCategoryRemove"/>
                </StackPanel>
                <StackPanel x:Name="ReceiptDetailsArea" Grid.Column="1" Spacing="8" MinHeight="220" PreviewKeyDown="ReceiptDetailKeyDown">
                    <TextBlock Text="明細" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid x:Name="ReceiptDetailForm" ColumnSpacing="16" RowSpacing="8" SizeChanged="ReceiptDetailFormSizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBox x:Name="ReceiptItemName" Header="品名" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemName"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ReceiptItemPrice" Header="単価" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemPrice"/>
                                <TextBox x:Name="ReceiptItemQuantity" Grid.Column="1" Header="数量" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemQuantity"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ReceiptItemDiscount" Header="単価値引（円）" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemDiscount"/>
                                <TextBox x:Name="ReceiptItemRateDiscount" Grid.Column="1" Header="率値引（%）" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemRateDiscount"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ReceiptItemTax" Header="税率" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged" AutomationProperties.AutomationId="ReceiptItemTax"/>
                                <ComboBox x:Name="ReceiptItemExpense" Grid.Column="1" Header="費用区分" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged" AutomationProperties.AutomationId="ReceiptItemExpense">
                                    <ComboBoxItem Content="固定費" Tag="Fixed"/><ComboBoxItem Content="変動費" Tag="Variable"/><ComboBoxItem Content="対象外" Tag="Excluded"/>
                                </ComboBox>
                            </Grid>
                            <ComboBox x:Name="ReceiptItemOccurrence" Header="発生区分" HorizontalAlignment="Stretch" SelectionChanged="ReceiptDetailChoiceChanged" AutomationProperties.AutomationId="ReceiptItemOccurrence">
                                <ComboBoxItem Content="定期" Tag="Regular"/><ComboBoxItem Content="不定期" Tag="Irregular"/><ComboBoxItem Content="臨時" Tag="Temporary"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="ReceiptDetailPeoplePane" Grid.Column="1" Spacing="4">
                            <TextBlock Text="対象人物"/>
                            <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                                <StackPanel x:Name="ReceiptDetailPeople" PreviewKeyDown="ReceiptPeopleKeyDown"/>
                            </ScrollViewer>
                            <TextBlock Text="0人でも追加できます" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="ReceiptItemMemo" Header="明細メモ" AcceptsReturn="False" TextWrapping="NoWrap" TextChanged="ReceiptDetailTextChanged" AutomationProperties.AutomationId="ReceiptItemMemo"/>
                    <TextBlock x:Name="ReceiptItemTaxWarning" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="ReceiptDetailError" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="ReceiptDetailApply" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay, FallbackValue=False}" Content="{x:Bind ViewModel.ApplyText, Mode=OneWay}" HorizontalAlignment="Right" Click="ApplyReceiptDetail" AutomationProperties.AutomationId="ReceiptDetailApply"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReceiptDetailReuse" IsEnabled="{x:Bind ViewModel.CanChangeDetail, Mode=OneWay, FallbackValue=False}" Content="流用" Click="ReuseReceiptDetail" AutomationProperties.AutomationId="ReceiptDetailReuse"/>
                        <Button x:Name="ReceiptDetailDelete" IsEnabled="{x:Bind ViewModel.CanChangeDetail, Mode=OneWay, FallbackValue=False}" Content="削除" Click="DeleteReceiptDetail" AutomationProperties.AutomationId="ReceiptDetailDelete"/>
                        <Button x:Name="ReceiptDetailUp" IsEnabled="{x:Bind ViewModel.CanMoveUp, Mode=OneWay, FallbackValue=False}" Content="↑" AutomationProperties.Name="明細を上へ" Click="MoveReceiptDetailUp" AutomationProperties.AutomationId="ReceiptDetailUp"/>
                        <Button x:Name="ReceiptDetailDown" IsEnabled="{x:Bind ViewModel.CanMoveDown, Mode=OneWay, FallbackValue=False}" Content="↓" AutomationProperties.Name="明細を下へ" Click="MoveReceiptDetailDown" AutomationProperties.AutomationId="ReceiptDetailDown"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                        <StackPanel MinWidth="620">
                            <Grid ColumnSpacing="8" Padding="12,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/><ColumnDefinition Width="140"/><ColumnDefinition Width="75"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBlock Text="品名"/><TextBlock Grid.Column="1" Text="単価" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="数量" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="値引" HorizontalAlignment="Right"/><TextBlock Grid.Column="4" Text="税率" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="参考額" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListView x:Name="ReceiptDetailsList" SelectionMode="Single" SelectionChanged="ReceiptDetailSelected" PreviewKeyDown="ReceiptDetailListKeyDown" MaxHeight="350" AutomationProperties.Name="選択中科目の明細" AutomationProperties.AutomationId="ReceiptDetailsList">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="presentation:ReceiptDetailRow">
                                    <Grid ColumnSpacing="8" Padding="0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/><ColumnDefinition Width="140"/><ColumnDefinition Width="75"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Price}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{x:Bind Quantity}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Discount}" HorizontalAlignment="Right"/><StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Tax}"/><TextBlock Text="{x:Bind TaxWarning, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel>
                                        <TextBlock Grid.Column="5" Text="{x:Bind ReferenceAmount, Mode=OneWay}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8">
        <TextBlock x:Name="ReceiptAccountingTotal" Text="{x:Bind ViewModel.AccountingTotal, Mode=OneWay}" TextWrapping="Wrap"/>
        <TextBlock x:Name="ReceiptCalculationNotice" Text="{x:Bind ViewModel.CalculationNotice, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind Show(ViewModel.HasCalculationNotice), Mode=OneWay, FallbackValue=Collapsed}"/>
        <TextBlock Text="現在は保存できません。登録・更新・流用登録は後続工程で接続します。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ReceiptRegister" Visibility="{x:Bind Show(ViewModel.IsNew), Mode=OneWay, FallbackValue=Collapsed}" Content="登録" IsEnabled="False" AutomationProperties.AutomationId="ReceiptRegister"/>
            <Button x:Name="ReceiptUpdate" Visibility="{x:Bind Show(ViewModel.IsExisting), Mode=OneWay, FallbackValue=Collapsed}" Content="更新" IsEnabled="False" AutomationProperties.AutomationId="ReceiptUpdate"/>
            <Button x:Name="ReceiptReuse" Visibility="{x:Bind Show(ViewModel.IsExisting), Mode=OneWay, FallbackValue=Collapsed}" Content="流用登録" IsEnabled="False" AutomationProperties.AutomationId="ReceiptReuse"/>

        </StackPanel>
    </StackPanel>
</Grid>
</Page>
