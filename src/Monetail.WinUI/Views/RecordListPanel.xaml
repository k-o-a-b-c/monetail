<UserControl
    x:Class="Monetail.WinUI.Views.RecordListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            <Button x:Name="ReturnToStart" Grid.Column="1" Content="先頭に戻る" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Command="{x:Bind ReturnToStartCommand, Mode=OneWay}" Visibility="{x:Bind Show(State.IsFocused), Mode=OneWay, FallbackValue=Collapsed}"
                    AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'ReturnToStart'), Mode=OneWay}"/>
            <Button x:Name="Register" Grid.Column="2" Content="＋ 登録" Command="{x:Bind RegisterCommand, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind RegistrationName(Heading), Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind RegisterAutomationId, Mode=OneWay}"/>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Grid Grid.Row="2">
            <ContentControl Content="{x:Bind ListContent, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
            <StackPanel x:Name="InitialNotice" Visibility="{x:Bind Show(State.IsInitialLoading), Mode=OneWay, FallbackValue=Collapsed}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'InitialNotice'), Mode=OneWay}">
                <ProgressRing x:Name="InitialProgress" IsActive="{x:Bind State.IsInitialLoading, Mode=OneWay, FallbackValue=False}" Width="32" Height="32" AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'InitialProgress'), Mode=OneWay}"/>
                <TextBlock Text="読み込み中…"/>
            </StackPanel>
            <TextBlock x:Name="Empty" Text="{x:Bind EmptyText, Mode=OneWay}" Visibility="{x:Bind Show(State.IsEmpty), Mode=OneWay, FallbackValue=Collapsed}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'Empty'), Mode=OneWay}"/>
            <StackPanel x:Name="InitialFailure" Visibility="{x:Bind Show(State.IsInitialFailure), Mode=OneWay, FallbackValue=Collapsed}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'InitialFailure'), Mode=OneWay}">
                <TextBlock x:Name="InitialError" Text="{x:Bind State.ErrorText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'InitialError'), Mode=OneWay}"/>
                <Button x:Name="InitialRetry" Content="再試行" Command="{x:Bind State.RetryCommand, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'InitialRetry'), Mode=OneWay}"/>
            </StackPanel>
            <Border x:Name="OpeningNotice" AutomationProperties.AutomationId="{x:Bind Id(AutomationPrefix, 'OpeningNotice'), Mode=OneWay}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    Visibility="{x:Bind OpeningContent.Visibility, Mode=OneWay, FallbackValue=Collapsed}">
                <ContentControl Content="{x:Bind OpeningContent, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsTabStop="False"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
