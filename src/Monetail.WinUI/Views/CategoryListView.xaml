<UserControl
    x:Class="Monetail.WinUI.Views.CategoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monetail.WinUI"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="科目管理" Style="{ThemeResource TitleTextBlockStyle}"/>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="AddCategoryButton" Content="追加" Click="AddCategory" AutomationProperties.AutomationId="AddCategoryButton"/>
            <Button Grid.Column="1" x:Name="EditCategoryButton" Content="編集" Click="EditCategory" AutomationProperties.AutomationId="EditCategoryButton"/>
            <Button Grid.Column="2" HorizontalAlignment="Left" x:Name="DeleteCategoryButton" Content="削除" Click="DeleteCategory" AutomationProperties.AutomationId="DeleteCategoryButton"/>
            <Button x:Name="CategoryOrderButton" Grid.Column="3" Content="並び順変更" Click="OpenCategoryOrder" AutomationProperties.AutomationId="CategoryOrderButton"/>
        </Grid>
        <CheckBox x:Name="IncludeInactiveCategories" Grid.Row="2" Content="有効期間外も表示" Checked="FilterCategories" Unchecked="FilterCategories" AutomationProperties.AutomationId="IncludeInactiveCategories"/>
        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Padding="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="88"/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock Text="科目名"/><TextBlock Grid.Column="1" Text="収支区分"/><TextBlock Grid.Column="2" Text="初期税区分"/><TextBlock Grid.Column="3" Text="有効開始日"/><TextBlock Grid.Column="4" Text="有効終了日"/>
            </Grid>
            <ListView x:Name="CategoriesList" Grid.Row="1" SelectionMode="Single" SelectionChanged="SelectCategory" HorizontalContentAlignment="Stretch" AutomationProperties.Name="科目一覧" AutomationProperties.AutomationId="CategoriesList">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate x:DataType="local:CategoryRow">
                    <Grid ColumnSpacing="12" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="88"/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{x:Bind IncomeExpense}"/><TextBlock Grid.Column="2" Text="{x:Bind TaxCategory}"/><TextBlock Grid.Column="3" Text="{x:Bind ValidFrom}"/><TextBlock Grid.Column="4" Text="{x:Bind ValidTo}"/>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyCategories" Grid.Row="1" Text="表示対象の科目はありません。" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
        </Grid>
    </Grid>
</UserControl>
