<UserControl
    x:Class="Monetail.WinUI.Views.LedgerChoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Grid Padding="32">
        <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
            <TextBlock Text="家計簿を選択" Style="{ThemeResource TitleTextBlockStyle}" />
            <ListView x:Name="LedgerChoices" DisplayMemberPath="Name" SelectionMode="Single" MaxHeight="320"
                      SelectionChanged="ChooseLedger" AutomationProperties.Name="参加している家計簿" AutomationProperties.AutomationId="LedgerChoices"/>
            <Button x:Name="OpenLedgerButton" Content="開く" IsEnabled="False" Click="OpenSelectedLedger"
                    Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="OpenLedgerButton"/>
        </StackPanel>
    </Grid>
</UserControl>
