<Page
    x:Class="Monetail.WinUI.Views.Authentication.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="32">
        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}"/>
            <StackPanel x:Name="LoginContent" Spacing="24">
                <Button x:Name="LoginButton" Content="ログイン" Click="RequestLogin"
                        Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="LoginButton"/>
                <HyperlinkButton x:Name="LoginChangeConnection" Content="接続先の変更" Click="RequestConnectionChange"
                                 AutomationProperties.AutomationId="LoginChangeConnection"/>
            </StackPanel>
            <StackPanel x:Name="WaitingContent" Visibility="Collapsed" Spacing="24">
                <TextBlock Text="ブラウザーでログインしてください。" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"/>
                <StackPanel x:Name="WaitingActions" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ReopenBrowserButton" Content="ブラウザーを開く" Click="RequestBrowserOpen"
                            AutomationProperties.AutomationId="ReopenBrowserButton"/>
                    <Button x:Name="CancelLoginButton" Content="キャンセル" Click="RequestCancel"
                            AutomationProperties.AutomationId="CancelLoginButton"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
