<Page
    x:Class="Monetail.WinUI.Views.Connection.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="32">
        <TextBlock Text="Monetail" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
        <ProgressRing x:Name="StartupProgress" IsActive="True" Width="32" Height="32"
                      AutomationProperties.Name="接続中"/>
        <TextBlock Text="接続中…" Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center"/>
    </StackPanel>
</Page>
