# 全てダミー値。チェックアウトの外へコピーし、実環境に合わせて編集する。
MONETAIL_DATA_DIR=/srv/monetail-data
MONETAIL_ORIGIN=https://monetail-api.tail-example.ts.net
MONETAIL_RP_ID=monetail-api.tail-example.ts.net
TAILSCALE_HOSTNAME=monetail-api
# 運用開始時に公式の安定版を確認する。更新も明示的に行う。
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
TZ=Etc/UTC
# 標準のネットワーク共有構成では変更しない。NAS本体のTailscale利用時だけ手順参照。
MONETAIL_TRUSTED_PROXY=127.0.0.1
