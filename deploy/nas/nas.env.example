# 全てダミー値。実環境に合わせて編集する。実際の設定・秘密ファイルはGit外へ保存する。
# 配布アーカイブのimages.envに記載された固定digestへ置換する。latestは使わない。
MONETAIL_IMAGE=ghcr.io/k-o-a-b-c/monetail-api:v0.0.0-example
MONETAIL_DATA_DIR=/srv/monetail-data
MONETAIL_ORIGIN=https://monetail.example.test
MONETAIL_RP_ID=monetail.example.test
TZ=Etc/UTC
# この配備例では、別管理のHTTPSプロキシの転送元はloopback。
MONETAIL_TRUSTED_PROXY=127.0.0.1
